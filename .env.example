# Copy to .env and edit. .env is git-ignored.

# Port on the host. Phones and the Android app use this port.
HOST_PORT=8096

# Address other devices should open. Shown in the app instead of the container IP.
# Same Wi-Fi: http://192.168.1.111:8096
# From the internet, after you forward HOST_PORT on the router:
# PUBLIC_URL=http://YOUR_PUBLIC_IP:8096
PUBLIC_URL=

# Only if Dramabox blocks this server's country (HTTP 403).
# DRAMABOX_PROXY=socks5://user:pass@proxy-host:1080

TZ=Africa/Johannesburg
